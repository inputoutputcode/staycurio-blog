---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import { galleryGroups, galleryItems } from '../data/realLifeFriendsGallery';

const galleryPreviewItems = galleryGroups[0].images.slice(0, 9).map(([src, caption]) => ({
	src,
	caption,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Real Life Friends | ${SITE_TITLE}`} description="Making real friends as an adult shouldn't be this hard. We match you with people who actually get your situation." />
		<style>
			.product-gallery {
				margin-top: 4rem;
				padding-top: 2rem;
				border-top: 1px solid rgb(var(--gray-light));
			}

			.gallery-intro {
				max-width: 48rem;
			}

			.gallery-preview {
				width: min(18rem, 42vw);
				margin: 1.25rem auto 1.75rem;
			}

			.gallery-preview a {
				display: block;
				color: inherit;
				text-decoration: none;
			}

			.gallery-preview-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 0.3rem;
				padding: 0.45rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: #e9eef6;
				box-shadow: var(--box-shadow);
				transition: transform 160ms ease, box-shadow 160ms ease;
			}

			.gallery-preview a:hover .gallery-preview-grid,
			.gallery-preview a:focus-visible .gallery-preview-grid {
				transform: translateY(-2px);
				box-shadow: 0 12px 28px rgba(var(--gray), 0.22);
			}

			.gallery-preview-item {
				overflow: hidden;
				border: 1px solid rgba(var(--gray), 0.14);
				border-radius: 5px;
				background: white;
			}

			.gallery-preview-item img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				object-position: top left;
				border-radius: 0;
				background: rgb(var(--gray-light));
			}

			.gallery-preview-label {
				display: block;
				grid-column: 1 / -1;
				padding: 0.25rem 0.1rem 0;
				font-size: 0.85rem;
				font-weight: 700;
				line-height: 1.2;
				color: rgb(var(--gray-dark));
			}

			.gallery-group {
				margin-top: 2.5rem;
			}

			.gallery-group header {
				margin-bottom: 1rem;
			}

			.gallery-group h3 {
				margin-bottom: 0.25rem;
			}

			.gallery-group p {
				margin: 0;
				color: rgb(var(--gray));
			}

			.gallery-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}

			.gallery-card {
				margin: 0;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: white;
				box-shadow: var(--box-shadow);
			}

			.gallery-card a {
				display: block;
				color: inherit;
				text-decoration: none;
			}

			.gallery-card img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 10;
				object-fit: cover;
				object-position: top left;
				background: rgb(var(--gray-light));
			}

			.gallery-card figcaption {
				padding: 0.65rem 0.75rem;
				font-size: 0.9rem;
				line-height: 1.3;
				color: rgb(var(--gray-dark));
			}

			@media (max-width: 640px) {
				.gallery-preview {
					width: 100%;
					max-width: 22rem;
					margin: 1rem 0 1.5rem;
				}

				.gallery-preview-grid {
					grid-template-columns: repeat(3, minmax(0, 1fr));
				}

				.gallery-preview-item:nth-child(n + 7) {
					display: none;
				}

				.gallery-grid {
					display: flex;
					overflow-x: auto;
					gap: 0.875rem;
					padding-bottom: 0.5rem;
					scroll-snap-type: x mandatory;
				}

				.gallery-card {
					flex: 0 0 min(82vw, 320px);
					scroll-snap-align: start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Real Life Friends</h1>
			<p>
				Making real friends as an adult shouldn't be this hard.
			</p>

			<h2>The Problem</h2>
			<p>
				You moved to a new city. You work remotely. Your old friends are scattered across the country. 
				Apps give you endless profiles but no real connections. You're not looking for networking events 
				or forced group activities—you just want to meet someone who gets it.
			</p>

			<h2>How It Works</h2>
			<p>
				We match you with one person at a time based on what actually matters: where you are in life, 
				what you're looking for, and why you'd genuinely enjoy meeting each other.
			</p>
			<p>
				No swiping. No algorithms optimizing for engagement. Just thoughtful introductions between 
				people who have a real reason to connect.
			</p>
			<aside class="gallery-preview" aria-label="Product gallery preview">
				<a href="#product-gallery-heading" aria-label="View the full Real Life Friends product gallery">
					<div class="gallery-preview-grid">
						{galleryPreviewItems.map((item) => (
							<div class="gallery-preview-item">
								<img src={item.src} alt={`Real Life Friends screenshot: ${item.caption}`} loading="eager" decoding="async" />
							</div>
						))}
						<span class="gallery-preview-label">Gallery</span>
					</div>
				</a>
			</aside>

			<h2>What Makes Us Different</h2>
			<ul>
				<li><strong>Intent first</strong> — We match based on what kind of connection you're actually looking for, whether that's an activity partner, someone for deep conversations, or just low-key friendship.</li>
				<li><strong>Life context matters</strong> — New to town? Working remote? Going through a transition? We connect you with people navigating similar situations, not just people who like the same hobbies.</li>
				<li><strong>Clear next steps</strong> — Every introduction comes with a specific reason to meet, a suggested spot, and a conversation starter. No awkward "so... why are we here?"</li>
			</ul>

			<h2>Pilot Program</h2>
			<p>
				We're starting small with a pilot in Bend, Oregon. If you're interested in being part of the 
				first cohort, reach out.
			</p>

			<section class="product-gallery" aria-labelledby="product-gallery-heading">
				<div class="gallery-intro">
					<h2 id="product-gallery-heading">Product Gallery</h2>
					<p>
						A grouped view of the Real Life Friends product surface, from the member journey to the admin and evaluation tools behind each introduction.
					</p>
				</div>

				{galleryGroups.map((group) => (
					<section class="gallery-group" aria-labelledby={`${group.title.toLowerCase().replaceAll(' ', '-')}-heading`}>
						<header>
							<h3 id={`${group.title.toLowerCase().replaceAll(' ', '-')}-heading`}>{group.title}</h3>
							<p>{group.description}</p>
						</header>
						<div class="gallery-grid">
							{group.images.map(([src, caption]) => {
								const item = galleryItems.find((galleryItem) => galleryItem.src === src);
								return (
								<figure class="gallery-card">
									<a href={`/real-life-friends/gallery/${item?.id ?? ''}`}>
										<img src={src} alt={`Real Life Friends screenshot: ${caption}`} loading="lazy" decoding="async" />
										<figcaption>{caption}</figcaption>
									</a>
								</figure>
								);
							})}
						</div>
					</section>
				))}
			</section>

			<p>
				<a href="/">← Back to Home</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
