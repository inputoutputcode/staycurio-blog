---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About StayCurio" />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 2em 1em;
			}
			.profile-image {
				display: block;
				margin: 0 auto 2em auto;
				border-radius: 12px;
				max-width: 30%;
				height: auto;
			}
			h1 {
				text-align: center;
				margin-bottom: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<img src="/christian-profile.png" alt="Christian" class="profile-image" />
			<h1>About</h1>
			<p>
				<strong>StayCurio</strong>
			</p>
			<p>
				Christian has been building software since 2001, moving through the full stack from web and frontend work to large scale backend and distributed systems. His recent exploration of the DGX Spark is part of a broader effort to understand how modern AI and open source infrastructure fit together in practice.
			</p>
		</main>
		<Footer />
	</body>
</html>
