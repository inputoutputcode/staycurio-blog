---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>AI Systems Engineering</h1>
			<p>
				We build intelligent solutions that solve real-world problems. Our expertise spans machine learning, 
				natural language processing, and end-to-end AI system design.
			</p>
			
			<br />
			<h2 class="projects-heading">Current Projects</h2>
			<br />
			<h3 class="project-title">RLF social experiment</h3>
			<p>
				An AI-powered application designed to foster genuine human connections in a digital world. 
				Real Life Friends helps people move beyond superficial interactions and build meaningful relationships 
				through curiosity-driven conversations.
			</p>
			<p class="project-link">
				<a href="/real-life-friends">Learn more about Real Life Friends →</a>
			</p>

			<br />
			<h3 class="project-title">AI infrastructure lab</h3>
			<p>
				A hands-on exploration of local AI systems engineering: NVIDIA DGX Spark, local LLM inference, 
				benchmarking, RAG experiments, ETL, fine tuning, and the production infrastructure patterns behind 
				reliable AI applications.
			</p>
			<p>
				<a href="/ai-engineering">Read the AI infrastructure lab notes →</a>
			</p>

			<br />
			<h2>Let's Talk</h2>
			<p>
				Have a project in mind? We'd love to hear about it. Reach out via 
				<a href="https://www.linkedin.com/in/christian-pappert" target="_blank">LinkedIn</a> 
				or check out our work on <a href="https://github.com/inputoutputcode" target="_blank">GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.projects-heading {
		margin-bottom: 1.25rem;
	}
	.project-title {
		font-size: 1.65em;
	}
	.project-link {
		margin-bottom: 2rem;
	}
</style>
